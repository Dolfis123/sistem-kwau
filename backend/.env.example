# Server
PORT=5000
NODE_ENV=development

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kwau_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRES_IN=1d

# Akun superadmin awal (dipakai oleh: npm run seed)
SEED_ADMIN_NAMA=Superadmin Kwau
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=admin@kwau.id
SEED_ADMIN_PASSWORD=GantiPassword123!

# WhatsApp resmi Pokdarwis (format 62xxx, tanpa +)
WA_POKDARWIS=6282100000000

# URL frontend (untuk CORS)
FRONTEND_URL=http://localhost:5173
